#!/usr/bin/env bash
# exo — Exocortex daemon debugging CLI.
set -euo pipefail

# Resolve launcher symlinks without GNU-only readlink -f (stock macOS).
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" = /* ]] || SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

find_bun() {
  if command -v bun >/dev/null 2>&1; then
    command -v bun
    return 0
  fi
  if [[ -x "$HOME/.bun/bin/bun" ]]; then
    printf '%s\n' "$HOME/.bun/bin/bun"
    return 0
  fi
  if [[ -x "$HOME/.local/bun/bin/bun" ]]; then
    printf '%s\n' "$HOME/.local/bun/bin/bun"
    return 0
  fi
  return 1
}

BUN="$(find_bun)" || {
  printf '  ✗ bun is required but not found. Install: curl -fsSL https://bun.sh/install | bash\n' >&2
  exit 1
}

exec "$BUN" run "$PROJECT_DIR/src/main.ts" "$@"
